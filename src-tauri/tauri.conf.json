{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DramaDossier",
  "version": "0.2.2",
  "identifier": "dev.dramadossier.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "剧备 DramaDossier",
        "width": 1200,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "短剧报审材料自动生成工具",
    "longDescription": "扫描剧集素材，探测分集规格，检查报审材料完整性，并生成结构化报审包与真实数据成本表。"
  }
}
