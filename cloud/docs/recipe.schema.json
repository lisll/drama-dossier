{
  "$defs": {
    "Compatibility": {
      "additionalProperties": false,
      "properties": {
        "min_worker_version": {
          "default": "1.0.0",
          "title": "Min Worker Version",
          "type": "string"
        },
        "required_capabilities": {
          "items": {
            "type": "string"
          },
          "title": "Required Capabilities",
          "type": "array"
        }
      },
      "title": "Compatibility",
      "type": "object"
    },
    "PipelineStep": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "module": {
          "title": "Module",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        }
      },
      "required": [
        "id",
        "module"
      ],
      "title": "PipelineStep",
      "type": "object"
    },
    "Preset": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "default": "no_edit",
          "enum": [
            "no_edit",
            "subtitle",
            "full_edit"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "title": "Preset",
      "type": "object"
    },
    "QualityPolicy": {
      "additionalProperties": false,
      "properties": {
        "check_audio_video_sync": {
          "default": true,
          "title": "Check Audio Video Sync",
          "type": "boolean"
        },
        "max_av_sync_ms": {
          "default": 200.0,
          "title": "Max Av Sync Ms",
          "type": "number"
        },
        "min_duration_seconds": {
          "default": 0.5,
          "title": "Min Duration Seconds",
          "type": "number"
        },
        "require_decodable_output": {
          "default": true,
          "title": "Require Decodable Output",
          "type": "boolean"
        },
        "validate_target_profile": {
          "default": true,
          "title": "Validate Target Profile",
          "type": "boolean"
        }
      },
      "title": "QualityPolicy",
      "type": "object"
    },
    "Target": {
      "additionalProperties": false,
      "properties": {
        "audio_codec": {
          "title": "Audio Codec",
          "type": "string"
        },
        "container": {
          "title": "Container",
          "type": "string"
        },
        "height": {
          "anyOf": [
            {
              "maximum": 4320,
              "minimum": 16,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height"
        },
        "platform_profile": {
          "title": "Platform Profile",
          "type": "string"
        },
        "video_codec": {
          "title": "Video Codec",
          "type": "string"
        },
        "width": {
          "anyOf": [
            {
              "maximum": 7680,
              "minimum": 16,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width"
        }
      },
      "required": [
        "platform_profile",
        "container",
        "video_codec",
        "audio_codec"
      ],
      "title": "Target",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "compatibility": {
      "$ref": "#/$defs/Compatibility"
    },
    "pipeline": {
      "items": {
        "$ref": "#/$defs/PipelineStep"
      },
      "title": "Pipeline",
      "type": "array"
    },
    "preset": {
      "$ref": "#/$defs/Preset"
    },
    "quality_policy": {
      "$ref": "#/$defs/QualityPolicy"
    },
    "recipe_id": {
      "title": "Recipe Id",
      "type": "string"
    },
    "schema_version": {
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "default": "draft",
      "enum": [
        "draft",
        "reviewing",
        "published",
        "deprecated",
        "revoked"
      ],
      "title": "Status",
      "type": "string"
    },
    "target": {
      "$ref": "#/$defs/Target"
    },
    "version": {
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "recipe_id",
    "version",
    "target",
    "pipeline"
  ],
  "title": "Recipe",
  "type": "object"
}
