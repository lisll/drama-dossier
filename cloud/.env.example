# 部署配置模板（M7-7）。复制成 .env 再逐项填。
#
#   cp .env.example .env
#   chmod 600 .env      # 里面有密码
#
# **.env 不进仓库**（.gitignore 已排除）。这份模板里没有真实密码。

# ---------- 数据库 ----------
POSTGRES_USER=drama
# 换成随机强密码：openssl rand -base64 24
POSTGRES_PASSWORD=
COMMERCE_DB=drama_commerce
MEDIA_DB=drama_media

# ---------- 两个服务之间的内部通信 ----------
# 必须一致；生成：openssl rand -base64 32
INTERNAL_SECRET=
# 验证码与限流键的 HMAC 密钥，至少 32 字符；生成：openssl rand -base64 48
CODE_SECRET=

# ---------- 对外地址 ----------
# 局域网 IP 或内网域名。Caddy 用它做站点名，桌面端用它拼回调地址。
DEPLOY_HOST=drama.local
PUBLIC_BASE_URL=https://drama.local
HTTP_PORT=80
HTTPS_PORT=443

# ---------- 目录（相对本文件或绝对路径）----------
# 放 license.pem（以及轮换期的 license-secondary.pem）的目录。
KEYS_DIR=./keys
# 放 cert.pem / key.pem 的目录。
TLS_DIR=./tls
# 报审包 PDF 用的中文字体；留空则用镜像里的 Noto CJK。
FONTS_DIR=./fonts
PDF_FONT=

# ---------- 签名密钥轮换（可选）----------
# 过渡期内填次私钥路径（容器内路径）；轮换结束后留空。见 docs/KEY_ROTATION.md。
LICENSE_KEY_SECONDARY=

# ---------- 邮件 ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
PRODUCT_NAME=剧备 DramaDossier

# ---------- 支付 ----------
# 本地模拟支付的签名密钥。空值时模拟收银台不可用（这是刻意的：
# 空密钥等于谁都能伪造回调）。生成：openssl rand -base64 32
MOCK_PAY_SECRET=

# ---------- 保留期（天）----------
ASSET_RETENTION_DAYS=30
UPLOAD_RETENTION_DAYS=7
ARTIFACT_RETENTION_DAYS=30
