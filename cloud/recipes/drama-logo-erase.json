{
  "schema_version": "1.0",
  "recipe_id": "drama.logo.erase",
  "version": 1,
  "status": "published",
  "target": {
    "platform_profile": "generic-h264-mp4",
    "container": "mp4",
    "video_codec": "h264",
    "audio_codec": "aac"
  },
  "compatibility": {
    "min_worker_version": "1.0.0",
    "required_capabilities": ["h264_encode", "video_inpaint"]
  },
  "preset": { "mode": "no_edit" },
  "pipeline": [
    { "id": "probe", "module": "media.probe", "params": {} },
    {
      "id": "erase",
      "module": "video.inpaint",
      "params": {
        "regions": [{ "x": 0, "y": 0, "width": 64, "height": 48 }],
        "detector": "fixed",
        "inpainter": "column",
        "dilate": 4,
        "feather": 2,
        "pix_fmt": "yuv420p",
        "defer_verdict": true,
        "escalation": "mask"
      }
    },
    {
      "id": "erase_check",
      "module": "video.erase_verify",
      "params": { "require_content_check": false, "accept_warn": true }
    },
    {
      "id": "encode",
      "module": "media.encode",
      "params": {
        "video_codec": "h264",
        "audio_codec": "aac",
        "container": "mp4",
        "crf": 21,
        "preset": "medium",
        "pix_fmt": "yuv420p"
      }
    },
    { "id": "gate", "module": "media.quality_gate", "params": {} }
  ],
  "quality_policy": {
    "require_decodable_output": true,
    "check_audio_video_sync": true,
    "validate_target_profile": true,
    "max_av_sync_ms": 200.0,
    "min_duration_seconds": 0.5
  }
}
