{
  "schema_version": "1.0",
  "recipe_id": "drama.full_edit",
  "version": 1,
  "status": "published",
  "target": {
    "platform_profile": "vertical-1080x1920",
    "container": "mp4",
    "video_codec": "h264",
    "audio_codec": "aac",
    "width": 1080,
    "height": 1920
  },
  "compatibility": {
    "min_worker_version": "1.0.0",
    "required_capabilities": ["h264_encode", "video_filters", "audio_filters"]
  },
  "preset": { "mode": "full_edit" },
  "pipeline": [
    { "id": "probe", "module": "media.probe", "params": {} },
    {
      "id": "timeline",
      "module": "timeline.user_edits",
      "params": { "segments": [], "scene_detect": true, "scene_threshold": 0.35 }
    },
    {
      "id": "video",
      "module": "video.quality",
      "params": {
        "scale": { "width": 1080, "height": 1920, "mode": "pad", "pad_color": "black" },
        "color": { "saturation": 0.05 },
        "sharpen": 0.4,
        "denoise": "light"
      }
    },
    {
      "id": "audio",
      "module": "audio.quality",
      "params": {
        "measure": true,
        "loudness": { "target_lufs": -16.0, "true_peak": -1.5, "range_lu": 11.0 },
        "compressor": { "threshold": -20.0, "ratio": 2.0, "attack": 20.0, "release": 250.0 }
      }
    },
    {
      "id": "metadata",
      "module": "metadata.policy",
      "params": { "mode": "edit", "strip_location": true, "remove": [] }
    },
    {
      "id": "chapters",
      "module": "chapters.reorg",
      "params": { "mode": "chapters", "split": false }
    },
    {
      "id": "encode",
      "module": "media.encode",
      "params": {
        "video_codec": "h264",
        "audio_codec": "aac",
        "container": "mp4",
        "crf": 23,
        "preset": "medium",
        "pix_fmt": "yuv420p",
        "gop_seconds": 2.0
      }
    },
    { "id": "gate", "module": "media.quality_gate", "params": { "duration_tolerance_seconds": 1.0 } }
  ],
  "quality_policy": {
    "require_decodable_output": true,
    "check_audio_video_sync": true,
    "validate_target_profile": true,
    "max_av_sync_ms": 200.0,
    "min_duration_seconds": 0.5
  }
}
