# 本地环境
.env
.env.*
# 但配置模板要入库：它里面没有真实密码，只是字段说明与占位值。
!.env.example

# 部署用的签名私钥与 TLS 证书（cloud/.env.example 里的 KEYS_DIR / TLS_DIR 默认值）。
# 私钥泄露等于任何人都能伪造授权凭证与升级包，所以宁可多忽略几个目录。
cloud/keys/
cloud/tls/
*.pem
*.key
*.p12
*.pfx

# NarraFork 本地工作目录（计划、附件缓存）
.narrafork/

# 模型权重（体积大、许可证独立，一律不入库）
tools/model_worker/models/
*.onnx
*.pth
*.pt

# 云端制作系统运行目录（数据库 / 对象存储 / 工作目录 / 签名密钥，全部可删可重建）
cloud/var/
*.sqlite3
*.sqlite3-wal
*.sqlite3-shm
