# /etc/dd-license/env （权限 0640 root:ddlicense）
DD_LICENSE_DB=/var/lib/dd-license/license.sqlite3
DD_LICENSE_KEY_FILE=/etc/dd-license/key.pem
DD_LICENSE_TOKEN_DAYS=7
# 后台 IP 白名单：只有这些地址能看到 /admin。改成你自己的出口 IP。
DD_LICENSE_ADMIN_ALLOW_IPS=203.0.113.10/32
# 部署在本机 Caddy 后面时必须开启，否则拿不到真实客户端 IP
DD_LICENSE_TRUST_PROXY=1
# 动态 IP 才考虑打开（会让任何人都看到登录页，不推荐）
# DD_LICENSE_ADMIN_ALLOW_ANY_IP=1
